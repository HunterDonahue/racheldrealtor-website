---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Layout
  title="Blog | Rachel Donahue, Fort Worth Realtor"
  description="Market updates, neighborhood guides, and straightforward advice for Fort Worth home buyers and sellers, from Rachel Donahue."
>
  <section class="blog-index-hero">
    <div class="wrap">
      <p class="eyebrow">The Blog</p>
      <h1>Market Notes &amp; Neighborhood Guides</h1>
      <p class="lede">Real talk about Fort Worth real estate &mdash; what's actually happening in the market, and what it means for your street specifically.</p>
    </div>
  </section>

  <section class="blog-index-list">
    <div class="wrap">
      <div class="post-grid">
        {allPosts.map(post => (
          <a href={`/blog/${post.id}/`} class="card post-card">
            {post.data.heroImage && <img src={post.data.heroImage} alt="" class="post-card-img" />}
            <div class="post-card-body">
              <span class="tag-label">{post.data.tags[0] ?? 'Market Update'}</span>
              <h2 class="post-card-title">{post.data.title}</h2>
              <p class="post-card-desc">{post.data.description}</p>
              <time class="post-card-date">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <style>
    .blog-index-hero { background: var(--white); padding-bottom: 2rem; }
    .blog-index-hero .lede { max-width: 56ch; }
    .post-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; }
    .post-card { text-decoration: none; color: var(--ink); display: flex; flex-direction: column; }
    .post-card-img { aspect-ratio: 16/9; object-fit: cover; }
    .post-card-body { padding: 1.6rem 1.6rem 1.8rem; }
    .post-card-title { font-size: 1.35rem; margin: 0.6rem 0 0.7rem; }
    .post-card-desc { font-size: 0.95rem; margin-bottom: 0.9rem; }
    .post-card-date { font-size: 0.8rem; color: var(--ink-soft); }
    @media (max-width: 720px) { .post-grid { grid-template-columns: 1fr; } }
  </style>
</Layout>
